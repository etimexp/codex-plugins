# read-image 插件本地配置（已加入 .gitignore，请勿外传或提交到版本库）

# 智谱 API Key
OPENAI_API_KEY=

# 智谱 OpenAI 兼容端点
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 视觉模型：GLM-5.2 是纯文本旗舰模型，不支持图片输入；
# 图片理解请用智谱 VLM 系列，可改为 glm-4.6v / glm-4.6v-flash / glm-ocr 等
READ_IMAGE_MODEL=glm-5v-turbo

# 可选：READ_IMAGE_API_STYLE=chat_completions（智谱）或 responses（OpenAI）
# 可选：READ_IMAGE_IMAGE_URL_FORMAT=base64（智谱默认）或 data_url
# 可选：READ_IMAGE_THINKING=enabled 开启深度思考模式
# 可选：READ_IMAGE_MAX_TOKENS=1024
# 可选：READ_IMAGE_TIMEOUT=180
