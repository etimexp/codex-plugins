# gen-image 插件本地配置(已加入 .gitignore,请勿提交到版本库)

# 千问 / DashScope(阿里云百炼)API Key —— 插件默认使用千问模型
GEN_IMAGE_API_KEY=

# 生图模型(DashScope 千问/qwen-image 系列)
#   qwen-image-plus  默认:质量更好
#   qwen-image       基础版:更快、更便宜
#   qwen-image-3.0 / qwen-image-3.0-pro  最新一代(走多模态端点同步返回,较慢)
GEN_IMAGE_MODEL=qwen-image-plus

# 千问图像接口(DashScope 原生端点,不是 OpenAI 兼容端点)
GEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# --- 备用:智谱 GLM(如需切回,取消下面注释,并注释掉上面的模型与端点) ---
# ZHIPU_API_KEY=
# GEN_IMAGE_MODEL=glm-image
# GEN_IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 默认图片尺寸(传给接口的 size,如 1024x1024 / 1536x1024 / 1024x1536 / auto)
# 千问端点内部会自动转换成 1024*1024 形式,无需手动写星号
# GEN_IMAGE_SIZE=1024x1024

# 图片输出目录(默认 ~/.codex/generated_images)
# GEN_IMAGE_OUTPUT_DIR=C:\Users\zhifu\.codex\generated_images

# 请求超时秒数(默认 180;qwen-image-plus 实测 10~30 秒左右出图)
# GEN_IMAGE_TIMEOUT=180

# 水印控制: 默认不加水印(false);如需加水印设为 true
# 注意: 关闭水印可能需先在平台签署免责声明
# GEN_IMAGE_WATERMARK=true
