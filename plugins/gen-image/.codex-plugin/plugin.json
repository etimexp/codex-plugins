    "capabilities": [
      "Generate"
    ],
    "defaultPrompt": [
      "\u7528 generate_image(\u5343\u95ee\u6a21\u578b)\u751f\u6210\u4e00\u5f20\u5173\u4e8e\u57ce\u5e02\u5929\u9645\u7ebf\u7684\u56fe\u7247\u3002",
      "\u5e2e\u6211\u7528\u5343\u95ee\u751f\u6210\u4e00\u5f20 PPT \u914d\u56fe:\u4eba\u5de5\u667a\u80fd\u4e0e\u7b97\u529b\u53d1\u5c55\u8d8b\u52bf\u3002",
